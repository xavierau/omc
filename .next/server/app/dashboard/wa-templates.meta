{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/wa-templates/layout,_N_T_/dashboard/wa-templates/page,_N_T_/dashboard/wa-templates"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/wa-templates/__PAGE__",
    "/dashboard/wa-templates",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}