# =============================================================================
# App
# =============================================================================
NODE_ENV=production
PORT=3100
APP_URL=https://app.ohmyclient.io
NEXT_PUBLIC_APP_URL=https://app.ohmyclient.io
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# WhatsApp BSP provider: kapso | ycloud (default: kapso)
# =============================================================================
WHATSAPP_PROVIDER=kapso
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# =============================================================================
# Email provider: resend (default: resend)
# REPLY-005: used to notify a restaurant of a "contact us" form submission.
# Missing RESEND_API_KEY or RESEND_FROM_EMAIL degrades to a skipped send
# (logged, never throws) — form mode falls back to the redirect CTA.
# =============================================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =============================================================================
# Google Gemini (Receipt AI parsing)
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# FlowForge (Automation engine)
# =============================================================================
FLOWFORGE_API_URL=
FLOWFORGE_API_TOKEN=

# =============================================================================
# Receipt Layout Service (Python microservice)
# Set LAYOUT_SERVICE_ENABLED=false to disable CV tamper detection entirely.
# =============================================================================
LAYOUT_SERVICE_ENABLED=true
LAYOUT_SERVICE_URL=http://localhost:8000
LAYOUT_SERVICE_API_KEY=

# =============================================================================
# Redis (BullMQ job queues)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Cron job auth
# =============================================================================
CRON_SECRET=

# =============================================================================
# Ops alerting (WAQ-013)
# Slack incoming-webhook URLs. Both optional — if missing, the notifier
# logs a warning and skips the post (production code never crashes).
#   - CS channel: yellow transitions, opt-out / throttle spikes, recovery clears.
#   - Platform channel: red transitions, auto-pause, WABA tier, engineering errors.
# =============================================================================
SLACK_WEBHOOK_URL_CS=
SLACK_WEBHOOK_URL_PLATFORM=

# =============================================================================
# WAQ message tracking (WAQ-001..013)
# WAQ_TRACK_MESSAGES: opt-OUT since #131 — set to exactly '0' to disable
#   recording outbound sends in whatsapp_messages. Unset/anything else =
#   tracking ON (default): status webhooks can find their row, per-user
#   cooldown enforces, KPI dashboards populate, orphan-reconcile cron has
#   rows to sweep, and async Meta rejections can retract a campaign's sent
#   counter. Only disable as an emergency kill switch.
# WAQ_BATCH_DELAY_MS: optional delay between campaign send chunks
#   (default 1000; invalid values fall back to the default).
# =============================================================================
WAQ_TRACK_MESSAGES=
WAQ_BATCH_DELAY_MS=

# =============================================================================
# Inbound-first opt-in (WONB-007)
# Platform-default UTILITY template for the opt-in confirmation prompt.
# Optional — without it (and without a per-tenant override) opt-in prompts
# are silently skipped with reason 'template_unset'.
# =============================================================================
KAPSO_DEFAULT_OPTIN_TEMPLATE_ID=

# =============================================================================
# INT-001 Member API (partner integrations) — docs/integrations/member-api.md
# and docs/integrations/member-api-ops.md for the full contract + runbook.
#
# INT_JOBID_KEY / INT001_SECRET_KEY are REQUIRED before the worker or the
# two partner routes will function — both throw fail-loud at first use if
# unset, never silently degrade. Generate each with:
#   openssl rand -base64 32
# (INT001_SECRET_KEY must decode to exactly 32 raw bytes — base64 or hex
# are both accepted; INT_JOBID_KEY has no length requirement, but treat it
# with the same care as any HMAC key. Rotating INT001_SECRET_KEY without a
# re-encryption migration makes every stored outbound secret undecryptable
# — do not rotate it in place.)
# =============================================================================
INT_JOBID_KEY=
INT001_SECRET_KEY=

# Worker concurrency (workers already share REDIS_URL above).
#   INT001_INBOUND_CONCURRENCY: member-create/welcome-send jobs (default 4).
#   INT001_OUTBOUND_CONCURRENCY: outbound delivery jobs (default 2, hard
#     capped at 4 regardless of a larger configured value).
INT001_INBOUND_CONCURRENCY=
INT001_OUTBOUND_CONCURRENCY=

# INT001_GLOBAL_QUEUE_CEILING: total waiting+delayed integration-inbound
#   jobs across every integration before new requests get
#   503 queue_depth_exceeded (default 5000).
# INT001_WELCOME_HOURLY_CAP: per-restaurant welcome-template sends per hour,
#   checked independently at create time and at send time (default 60).
INT001_GLOBAL_QUEUE_CEILING=
INT001_WELCOME_HOURLY_CAP=

# Emergency kill switches — set to exactly '1' to trip, unset/anything else
# = normal (enabled) behaviour. See docs/integrations/member-api-ops.md §10.
#   INT001_DISABLE_INBOUND: partner POST/GET routes answer
#     503 feature_disabled instead of processing.
#   INT001_DISABLE_OUTBOUND: outbound deliveries are marked 'paused'
#     instead of dialling out; they drain automatically once cleared.
INT001_DISABLE_INBOUND=
INT001_DISABLE_OUTBOUND=

# INT001_TEST_REDIS_URL: TEST-ONLY. Gates the real-Redis lane of the
# RateLimiterPort/queue contract test suites. Leave unset in every
# deployed environment (dev, staging, prod) and in CI — only set it on a
# developer machine with a local disposable Redis to run the integration
# lane before a merge.
INT001_TEST_REDIS_URL=
