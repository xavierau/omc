# =============================================================================
# App
# =============================================================================
NODE_ENV=production
PORT=3100
APP_URL=https://app.ohmyclient.io
NEXT_PUBLIC_APP_URL=https://app.ohmyclient.io
NEXT_PUBLIC_DEFAULT_LOCALE=zh-HK

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# WhatsApp BSP provider: kapso | ycloud (default: kapso)
# =============================================================================
WHATSAPP_PROVIDER=kapso
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# =============================================================================
# Email provider: resend (default: resend)
# REPLY-005: used to notify a restaurant of a "contact us" form submission.
# Missing RESEND_API_KEY or RESEND_FROM_EMAIL degrades to a skipped send
# (logged, never throws) — form mode falls back to the redirect CTA.
# =============================================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =============================================================================
# Google Gemini (Receipt AI parsing)
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# FlowForge (Automation engine)
# =============================================================================
FLOWFORGE_API_URL=
FLOWFORGE_API_TOKEN=

# =============================================================================
# Receipt Layout Service (Python microservice)
# Set LAYOUT_SERVICE_ENABLED=false to disable CV tamper detection entirely.
# =============================================================================
LAYOUT_SERVICE_ENABLED=true
LAYOUT_SERVICE_URL=http://localhost:8000
LAYOUT_SERVICE_API_KEY=

# =============================================================================
# Redis (BullMQ job queues)
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Cron job auth
# =============================================================================
CRON_SECRET=

# =============================================================================
# Ops alerting (WAQ-013)
# Slack incoming-webhook URLs. Both optional — if missing, the notifier
# logs a warning and skips the post (production code never crashes).
#   - CS channel: yellow transitions, opt-out / throttle spikes, recovery clears.
#   - Platform channel: red transitions, auto-pause, WABA tier, engineering errors.
# =============================================================================
SLACK_WEBHOOK_URL_CS=
SLACK_WEBHOOK_URL_PLATFORM=

# =============================================================================
# WAQ message tracking (WAQ-001..013)
# WAQ_TRACK_MESSAGES: set to exactly '1' to record outbound sends in
#   whatsapp_messages. Unset/other = the whole WAQ pipeline is dormant
#   (status webhooks find nothing, per-user cooldown never enforces,
#   KPI dashboards stay empty, orphan-reconcile cron sweeps nothing).
# WAQ_BATCH_DELAY_MS: optional delay between campaign send chunks
#   (default 1000; invalid values fall back to the default).
# =============================================================================
WAQ_TRACK_MESSAGES=
WAQ_BATCH_DELAY_MS=

# =============================================================================
# Inbound-first opt-in (WONB-007)
# Platform-default UTILITY template for the opt-in confirmation prompt.
# Optional — without it (and without a per-tenant override) opt-in prompts
# are silently skipped with reason 'template_unset'.
# =============================================================================
KAPSO_DEFAULT_OPTIN_TEMPLATE_ID=
